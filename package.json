{
  "name": "github-mastra-loop-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "runner:setup": "./scripts/setup-github-runner.sh",
    "runner:start": "./scripts/start-github-runner.sh",
    "runner:service:install": "./scripts/github-runner-service.sh install",
    "runner:service:start": "./scripts/github-runner-service.sh start",
    "runner:service:stop": "./scripts/github-runner-service.sh stop",
    "runner:service:status": "./scripts/github-runner-service.sh status",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@mastra/core": "1.55.0",
    "@mastra/libsql": "1.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.2"
}
