PORT=4317
DATABASE_PATH=.data/events.sqlite
MASTRA_DATABASE_URL=file:.data/mastra.sqlite
# Repository whose GitHub Actions jobs this runner accepts.
GITHUB_REPOSITORY=Soverius-AI/software-development-workflow-local-llms
# Leave empty for the loopback-only self-hosted-runner setup. Set this when a
# real GitHub webhook reaches the service through a tunnel.
GITHUB_WEBHOOK_SECRET=
GITHUB_BOT_LOGIN=loop-engineering-bot
# Optional GitHub App identity used to post readiness questions. Configure all
# three values together. Keep the PEM file under ignored .secrets/.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_GIT_BASE_URL=https://github.com
GITHUB_API_TIMEOUT_MS=15000
GITHUB_OUTBOX_RETRY_BASE_MS=5000
GITHUB_OUTBOX_MAX_ATTEMPTS=8
MAX_ACTIVE_IMPLEMENTATIONS=1
MODEL_BASE_URL=http://127.0.0.1:8888/v1
MODEL_API_KEY=local
READINESS_MODEL=unsloth/gemma-4-26B-A4B-it-GGUF:UD-Q4_K_XL
READINESS_TIMEOUT_MS=120000
# Codex inherits the model settings above unless these are overridden.
IMPLEMENTER_MODEL_BASE_URL=http://127.0.0.1:8888/v1
IMPLEMENTER_MODEL_API_KEY=local
IMPLEMENTER_MODEL=unsloth/gemma-4-26B-A4B-it-GGUF:UD-Q4_K_XL
IMPLEMENTER_REPOSITORY_PATH=.
IMPLEMENTER_BASE_BRANCH=main
IMPLEMENTER_WORKTREE_ROOT=.data/worktrees
IMPLEMENTER_CHECK_CONFIG=.implementer.json
IMPLEMENTER_TIMEOUT_MS=1800000
IMPLEMENTER_GIT_AUTHOR_NAME=Implementer Bot
IMPLEMENTER_GIT_AUTHOR_EMAIL=implementer@users.noreply.github.com
